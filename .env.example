# Add these in Vercel → Project → Settings → Environment Variables.
# Add at least one model key. People using the app won't need their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# Optional: lets the agent read Figma files without each person adding a token.
FIGMA_TOKEN=

# Strongly recommended when any key above is set: people must enter this code
# in Settings before the app will use your keys.
ACCESS_CODE=
